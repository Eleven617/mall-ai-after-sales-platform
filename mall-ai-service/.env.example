# DeepSeek：对话、意图识别和 Agent 决策
DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60

# RAG Embedding：项目内本地模型，演示时不需要 VPN
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_MODEL_PATH=models/embedding/bge-small-zh-v1.5
LOCAL_EMBEDDING_DIMENSION=512
LOCAL_EMBEDDING_THREADS=1

# Java mall 后端
MALL_API_BASE_URL=http://127.0.0.1:8085
MALL_API_TIMEOUT_SECONDS=10
MALL_ADMIN_API_BASE_URL=http://127.0.0.1:8080
MALL_ADMIN_API_TIMEOUT_SECONDS=10
AI_CASE_HANDOFF_SERVICE_KEY=replace_with_local_build19_service_key
AI_AFTER_SALES_SERVICE_KEY=replace_with_local_build21_after_sales_key

# Conversation state. Use memory for local learning; use redis for durable sessions.
CONVERSATION_STORE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=mall-ai:conversation
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_RECENT_MESSAGE_LIMIT=6
CONVERSATION_CONTEXT_TOKEN_BUDGET=1800
CONVERSATION_SUMMARY_MAX_CHARS=1600

# Build 21 Durable HITL.  Docker overrides the backend to redis; the checkpoint
# only stores an allow-listed waiting state, never Token, raw message, order ID,
# RAG content or raw tool response.  Use a non-default secret outside local demo.
DIAGNOSIS_CHECKPOINT_BACKEND=memory
DIAGNOSIS_CHECKPOINT_KEY_PREFIX=mall-ai:diagnosis-checkpoint
DIAGNOSIS_CHECKPOINT_TTL_SECONDS=1800
DIAGNOSIS_CHECKPOINT_LOCK_SECONDS=20
DIAGNOSIS_CHECKPOINT_MAX_BYTES=32768
DIAGNOSIS_CHECKPOINT_SECRET=replace_with_a_local_checkpoint_secret

# RAG evidence. The value is a Chroma cosine distance: lower means more relevant.
# 0.48 was calibrated with the reviewed local policy evaluation set; see
# docs/RAG_EVALUATION_EVIDENCE_2026-08-04.md before changing it.
RAG_TOP_K=3
RAG_MAX_DISTANCE=0.48

# Build 20 RAG 2.0. Dense remains the reviewed default until the same golden
# suite proves a safer/better Hybrid or Hybrid+Rerank result.  BM25/RRF and the
# Cross-Encoder are local; they do not add a cloud Embedding dependency.
RAG_RETRIEVAL_MODE=dense
RAG_HYBRID_CANDIDATE_K=8
RAG_BM25_MIN_SCORE=0.1
RAG_RRF_K=60
RAG_RERANKER_TOP_N=8
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_MODEL_PATH=models/reranker/bge-reranker-base
RAG_RERANKER_THREADS=1

# Trusted publication scope for policy metadata pre-filtering.  Update the
# active version together with a reviewed policy publication and re-ingest;
# do not let a model choose it.  Category remains unset unless Java provides
# a canonical product category for the current order.
RAG_ACTIVE_POLICY_VERSION=V1.1
RAG_POLICY_LANGUAGE=zh-CN
RAG_POLICY_DOCUMENT_TYPE=policy

# Explicit developer/CI quality checkpoints only; customer requests do not run them.
QUALITY_CHECKPOINT_MAX_CASES=60
QUALITY_CHECKPOINT_MAX_TOTAL_SECONDS=300
QUALITY_CHECKPOINT_LLM_TIMEOUT_SECONDS=20
QUALITY_CHECKPOINT_LLM_MAX_ATTEMPTS=1
