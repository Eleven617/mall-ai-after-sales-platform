    {
      "caseId": "customer-sensitive-handoff-is-rejected",
      "targetAgent": "customer_diagnosis",
      "syntheticInput": "合成政策咨询后的交接内容必须经过最小化合同边界。",
      "scriptedToolPlan": [
        {"name": "rag_search", "arguments": {"query": "合成交接政策"}}
      ],
      "mockToolResults": [
        {"tool": "rag_search", "result": {"sources": [{"document_name": "合成政策", "section_path": "人工交接"}], "no_evidence": false}}
      ],
      "mockCaseHandoff": {
        "case_id": "00000000-0000-4000-8000-000000000002",
        "source_flow": "customer_diagnosis",
        "diagnosis_category": "tool_failure",
        "evidence_status": "unavailable",
        "handoff_reason": "tool_failure",
        "requires_human_review": true,
        "case_status": "OPEN",
        "schema_version": "1",
        "order_sn": "synthetic-order-value",
        "authorization": "Bearer synthetic-only-value",
        "raw_message": "synthetic raw input",
        "rag_context": "synthetic policy content"
